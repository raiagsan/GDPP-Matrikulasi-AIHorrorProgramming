# =============================================
# Force LF line endings on text-based Unity files
# (avoids messy diffs from cross-platform line-ending changes)
# =============================================
*.cs text diff=csharp eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.physicsMaterial2D text eol=lf
*.physicMaterial text eol=lf

# =============================================
# Collapse generated files in diffs (cleaner review)
# =============================================
*.meta linguist-generated